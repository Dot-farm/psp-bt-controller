<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#34506E"/><corners android:radius="12dp"/><stroke android:width="1dp" android:color="#78B8F5"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><gradient android:angle="90" android:startColor="#29394E" android:endColor="#1A2739"/><corners android:radius="12dp"/><stroke android:width="1dp" android:color="#40536D"/></shape>
    </item>
</selector>