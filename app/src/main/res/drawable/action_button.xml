<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#435A75"/><stroke android:width="2dp" android:color="#A9D4FF"/></shape>
    </item>
    <item>
        <shape android:shape="oval"><gradient android:angle="90" android:startColor="#34465E" android:endColor="#1A2638"/><stroke android:width="1dp" android:color="#5A6F8B"/></shape>
    </item>
</selector>