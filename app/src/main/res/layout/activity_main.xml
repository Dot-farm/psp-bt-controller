<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <Button
        android:id="@+id/btnL"
        android:layout_width="140dp"
        android:layout_height="55dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="L"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true"
        android:backgroundTint="#1E88E5"
        android:text="Connect Bluetooth" />

    <Button
        android:id="@+id/btnR"
        android:layout_width="140dp"
        android:layout_height="55dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:text="R"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/inputPcIp"
        android:layout_width="190dp"
        android:layout_height="44dp"
        android:layout_below="@id/btnConnect"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="2dp"
        android:backgroundTint="#90CAF9"
        android:hint="Laptop IPv4 address"
        android:inputType="numberDecimal"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#BBBBBB"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnConnectPc"
        android:layout_width="190dp"
        android:layout_height="42dp"
        android:layout_below="@id/inputPcIp"
        android:layout_centerHorizontal="true"
        android:text="Connect to PC"
        android:textSize="12sp" />

    <GridLayout
        android:id="@+id/dpadGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_below="@id/btnL"
        android:layout_marginTop="16dp"
        android:columnCount="3"
        android:rowCount="3">

        <Space android:layout_width="55dp" android:layout_height="55dp" />
        <Button android:id="@+id/btnUp" android:layout_width="55dp" android:layout_height="55dp" android:text="▲" />
        <Space android:layout_width="55dp" android:layout_height="55dp" />

        <Button android:id="@+id/btnLeft" android:layout_width="55dp" android:layout_height="55dp" android:text="◀" />
        <Space android:layout_width="55dp" android:layout_height="55dp" />
        <Button android:id="@+id/btnRight" android:layout_width="55dp" android:layout_height="55dp" android:text="▶" />

        <Space android:layout_width="55dp" android:layout_height="55dp" />
        <Button android:id="@+id/btnDown" android:layout_width="55dp" android:layout_height="55dp" android:text="▼" />
        <Space android:layout_width="55dp" android:layout_height="55dp" />
    </GridLayout>

    <com.example.pspcontroller.AnalogStickView
        android:id="@+id/analogStick"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@id/dpadGrid"
        android:layout_marginStart="20dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSelect"
            android:layout_width="85dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:text="SELECT"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="85dp"
            android:layout_height="40dp"
            android:text="START"
            android:textSize="11sp" />
    </LinearLayout>

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:columnCount="3"
        android:rowCount="3">

        <Space android:layout_width="60dp" android:layout_height="60dp" />
        <Button android:id="@+id/btnTriangle" android:layout_width="60dp" android:layout_height="60dp" android:text="△" android:textSize="20sp" />
        <Space android:layout_width="60dp" android:layout_height="60dp" />

        <Button android:id="@+id/btnSquare" android:layout_width="60dp" android:layout_height="60dp" android:text="□" android:textSize="20sp" />
        <Space android:layout_width="60dp" android:layout_height="60dp" />
        <Button android:id="@+id/btnCircle" android:layout_width="60dp" android:layout_height="60dp" android:text="○" android:textSize="20sp" />

        <Space android:layout_width="60dp" android:layout_height="60dp" />
        <Button android:id="@+id/btnCross" android:layout_width="60dp" android:layout_height="60dp" android:text="✕" android:textSize="20sp" />
        <Space android:layout_width="60dp" android:layout_height="60dp" />
    </GridLayout>

</RelativeLayout>
